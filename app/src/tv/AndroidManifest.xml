<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV edition has its own launcher and only monitors YouTube for TV. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application tools:replace="android:label" android:label="ContentGuard Child TV"
        android:banner="@drawable/contentguard_opening">
        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name=".SplashActivity" tools:node="remove" />
        <service android:name=".GuardAccessibilityService" tools:node="remove" />

        <activity android:name=".TvMainActivity"
            android:label="ContentGuard Child TV"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TvYoutubeAccessibilityService"
            android:label="ContentGuard Child TV · Filtro YouTube"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/tv_accessibility_service_config" />
        </service>
    </application>
</manifest>
